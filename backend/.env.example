# Database
DATABASE_URL=postgresql+asyncpg://rfp_user:rfp_pass@localhost:5432/rfp_copilot
DATABASE_URL_SYNC=postgresql://rfp_user:rfp_pass@localhost:5432/rfp_copilot

# OpenAI
